{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{try{const j=JSON.parse(d);const f=(j.tool_input&&j.tool_input.file_path)||(j.tool_response&&j.tool_response.filePath)||'';if(/\\.(ts|tsx|js|jsx)$/.test(f)){require('child_process').execSync('npm run lint',{stdio:'inherit',cwd:process.cwd()});}}catch(e){}})\" || true",
            "timeout": 60,
            "statusMessage": "Chạy npm run lint..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run test)",
      "Bash(npm run test:*)",
      "Bash(git commit *)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(npx prisma migrate dev)",
      "Bash(npx prisma migrate dev *)",
      "Bash(npx prisma generate)"
    ]
  }
}
