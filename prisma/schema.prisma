// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum VaiTro {
  ADMIN
  CAN_BO_QUAN_LY_DAO_TAO
  CAN_BO_TAI_CHINH
  GIANG_VIEN
  HOC_VIEN
  CAN_BO_DON_VI_LIEN_KET
}

enum TrangThaiTaiKhoan {
  HOAT_DONG
  TAM_KHOA
}

enum PhuongThucDangKy {
  TRUC_TUYEN_NOP_GIAY
  IMPORT_TU_XAC_NHAN
  CHI_DU_THI
  QUA_DON_VI_LIEN_KET
}

enum TrangThaiChuongTrinh {
  DU_THAO
  CHO_THAM_DINH
  DA_BAN_HANH
  NGUNG_HIEU_LUC
}

enum HinhThucGiangDay {
  TRUC_TIEP
  TRUC_TUYEN
}

enum TrangThaiKhoa {
  CHUAN_BI
  DANG_TUYEN_SINH
  DANG_DIEN_RA
  DA_KET_THUC
  HUY
}

enum TrangThaiDangKy {
  // HV-01 (Phương thức 1): "Đã đăng ký online - chờ nộp bản giấy"
  CHO_NOP_GIAY
  // HV-02 (Phương thức 1): "Đã nộp hồ sơ giấy - chờ duyệt"
  DA_NOP_GIAY
  // HV-02: tự động hủy khi quá hạn nộp bản giấy mà chưa được xác nhận
  HUY_QUA_HAN_NOP_GIAY
  // HV-03 (Phương thức 2): đã import, "danh sách học viên dự kiến... kèm
  // thông tin định danh để tự xác nhận" - chờ học viên tự xác nhận (HV-04)
  CHO_TU_XAC_NHAN
  // HV-04 (Phương thức 2): "Đã xác nhận tham gia"
  DA_XAC_NHAN_THAM_GIA
  CHO_DUYET
  HOP_LE
  KHONG_HOP_LE
  CHINH_THUC
  HOAN_THANH
  THOI_HOC
}

enum TrangThaiDiemDanh {
  CO_MAT
  VANG_CO_PHEP
  VANG_KHONG_PHEP
}

enum TrangThaiHocPhi {
  CHUA_NOP
  DA_NOP_DU
  CON_NO
  MIEN_GIAM
  CHO_THANH_LY_HOP_DONG
  DA_HOAN_TAT
}

enum TrangThaiHopDong {
  DANG_TRIEN_KHAI
  DA_THANH_LY
}

enum TrangThaiChungChi {
  CHO_KY_DUYET
  DA_KY_DUYET
  DA_CAP
}

enum TrangThaiSaoLuu {
  DANG_CHAY
  THANH_CONG
  THAT_BAI
}

enum LoaiKichHoatSaoLuu {
  THU_CONG
  TU_DONG
}

// HV-10: các loại sự kiện phát sinh thông báo theo đặc tả. NHAC_HOC_PHI/
// KET_QUA/CAP_CHUNG_CHI chưa có điểm gọi thật (module HP/KQ/CC chưa xây) -
// định nghĩa sẵn để các module đó gọi guiThongBao() ngay khi được xây, không
// cần sửa schema thêm.
enum LoaiSuKienThongBao {
  TRUNG_TUYEN
  NHAC_NOP_HO_SO_GIAY
  LICH_HOC_LICH_THI
  NHAC_HOC_PHI
  KET_QUA
  CAP_CHUNG_CHI
}

// ============================================================
// NGƯỜI DÙNG & RBAC (QT-01, QT-02)
// Ma trận phân quyền Vai trò <-> Chức năng lưu trong DB (không hard-code)
// để admin gán/thu hồi quyền qua UI mà không cần sửa code.
// ============================================================

model NguoiDung {
  id          String            @id @default(cuid())
  tenDangNhap String            @unique
  matKhauHash String
  hoTen       String
  email       String?           @unique
  // học viên có thể đăng nhập bằng CCCD hoặc mã số học viên (Phương thức 2 - HV-04)
  soCCCD      String?           @unique
  maSoHocVien String?           @unique
  trangThai   TrangThaiTaiKhoan @default(HOAT_DONG)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  vaiTros      NguoiDungVaiTro[]
  giangVien    GiangVien?
  hocVien      HocVien?
  donViLienKet DonViLienKet?     @relation("TaiKhoanDonViLienKet")

  @@map("nguoi_dung")
}

model VaiTroModel {
  id         String  @id @default(cuid())
  ma         VaiTro  @unique
  tenHienThi String
  ghiChu     String?

  nguoiDungs NguoiDungVaiTro[]
  chucNangs  VaiTroChucNang[]

  @@map("vai_tro")
}

model NguoiDungVaiTro {
  nguoiDungId String
  vaiTroId    String

  nguoiDung NguoiDung   @relation(fields: [nguoiDungId], references: [id], onDelete: Cascade)
  vaiTro    VaiTroModel @relation(fields: [vaiTroId], references: [id], onDelete: Cascade)

  @@id([nguoiDungId, vaiTroId])
  @@map("nguoi_dung_vai_tro")
}

model ChucNangHeThong {
  id           String @id @default(cuid())
  // mã chức năng theo bảng phân tích 69 chức năng, vd "DM-01"
  maCN         String @unique
  nhomChucNang String
  tenChucNang  String

  vaiTros VaiTroChucNang[]

  @@map("chuc_nang_he_thong")
}

model VaiTroChucNang {
  vaiTroId          String
  chucNangHeThongId String

  vaiTro          VaiTroModel     @relation(fields: [vaiTroId], references: [id], onDelete: Cascade)
  chucNangHeThong ChucNangHeThong @relation(fields: [chucNangHeThongId], references: [id], onDelete: Cascade)

  @@id([vaiTroId, chucNangHeThongId])
  @@map("vai_tro_chuc_nang")
}

// ============================================================
// DANH MỤC DÙNG CHUNG (DM-01..DM-05)
// ============================================================

model DonVi {
  id         String  @id @default(cuid())
  ma         String  @unique
  ten        String
  donViChaId String?
  donViCha   DonVi?  @relation("DonViCapTren", fields: [donViChaId], references: [id])
  donViCons  DonVi[] @relation("DonViCapTren")

  giangViens GiangVien[]

  @@map("don_vi")
}

model ChucDanhHocVi {
  id   String @id @default(cuid())
  ma   String @unique
  ten  String
  // phân loại: chuc_danh | hoc_ham | hoc_vi
  loai String

  giangViens GiangVien[]
  hocViens   HocVien[]

  @@map("chuc_danh_hoc_vi")
}

model LoaiHinhBoiDuong {
  id  String @id @default(cuid())
  ma  String @unique
  ten String

  chuongTrinhs ChuongTrinh[]

  @@map("loai_hinh_boi_duong")
}

model PhongHoc {
  id      String  @id @default(cuid())
  ma      String  @unique
  ten     String
  coSo    String?
  sucChua Int?

  buoiHocs BuoiHoc[]

  @@map("phong_hoc")
}

model DotTuyenSinh {
  id          String   @id @default(cuid())
  ma          String   @unique
  ten         String
  ngayBatDau  DateTime
  ngayKetThuc DateTime

  khoas Khoa[]

  @@map("dot_tuyen_sinh")
}

// ============================================================
// 13 THỰC THỂ NGHIỆP VỤ CỐT LÕI (mục 3.1 đặc tả)
// Model rỗng ở bước nền tảng này; business logic/API cho từng CN
// sẽ code ở các phiên module DM/CT/KH/HV/GD/KQ/HP/CC/DVLK sau,
// theo đúng thứ tự Đợt 1 -> 2 -> 3.
// ============================================================

model ChuongTrinh {
  id                 String               @id @default(cuid())
  maCT               String               @unique
  ten                String
  mucTieu            String?
  doiTuongApDung     String?
  tongThoiLuong      Int?
  loaiHinhBoiDuongId String
  loaiHinhBoiDuong   LoaiHinhBoiDuong     @relation(fields: [loaiHinhBoiDuongId], references: [id])
  // CT-07: mỗi chương trình gắn đúng 1 trong 4 phương thức đăng ký;
  // mọi khóa mở theo chương trình kế thừa phương thức này.
  phuongThucDangKy   PhuongThucDangKy?
  // CT-03: quy trình Dự thảo -> Chờ thẩm định -> Đã ban hành.
  // CT-03: "Chỉ chương trình Đã ban hành mới được dùng để mở khóa" - ràng
  // buộc này áp dụng ở KH-01 (khởi tạo khóa) khi module đó được xây dựng.
  trangThai          TrangThaiChuongTrinh @default(DU_THAO)
  yKienThamDinh      String?
  soQuyetDinh        String?
  ngayBanHanh        DateTime?
  // CT-06: lý do/thời điểm chuyển sang Ngừng hiệu lực (lưu trữ) - chỉ có
  // giá trị khi trangThai = NGUNG_HIEU_LUC.
  lyDoNgungHieuLuc   String?
  ngayNgungHieuLuc   DateTime?
  // CT-04: mỗi lần sửa chương trình đã ban hành tăng số này lên 1 và lưu
  // snapshot nội dung trước khi sửa vào ChuongTrinhPhienBan.
  phienBanHienTai    Int                  @default(1)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  hocPhans  HocPhan[]
  khoas     Khoa[]
  phienBans ChuongTrinhPhienBan[]

  @@map("chuong_trinh")
}

// CT-04: snapshot nội dung chương trình TRƯỚC mỗi lần sửa khi đã ban hành -
// "lưu lại thành phiên bản mới, lưu lịch sử phiên bản cũ".
model ChuongTrinhPhienBan {
  id                 String      @id @default(cuid())
  chuongTrinhId      String
  chuongTrinh        ChuongTrinh @relation(fields: [chuongTrinhId], references: [id], onDelete: Cascade)
  phienBan           Int
  ten                String
  mucTieu            String?
  doiTuongApDung     String?
  tongThoiLuong      Int?
  loaiHinhBoiDuongId String
  lyDoSua            String?
  luuLucAt           DateTime    @default(now())

  @@unique([chuongTrinhId, phienBan])
  @@map("chuong_trinh_phien_ban")
}

model HocPhan {
  id            String      @id @default(cuid())
  chuongTrinhId String
  chuongTrinh   ChuongTrinh @relation(fields: [chuongTrinhId], references: [id], onDelete: Cascade)
  ten           String
  soTiet        Int
  thuTu         Int

  giangViens GiangVienHocPhan[]
  buoiHocs   BuoiHoc[]
  ketQuas    KetQuaHocTap[]

  @@map("hoc_phan")
}

model Khoa {
  id                  String           @id @default(cuid())
  maKhoa              String           @unique
  chuongTrinhId       String
  chuongTrinh         ChuongTrinh      @relation(fields: [chuongTrinhId], references: [id])
  dotTuyenSinhId      String?
  dotTuyenSinh        DotTuyenSinh?    @relation(fields: [dotTuyenSinhId], references: [id])
  thoiGianKhaiGiang   DateTime?
  thoiGianBeGiang     DateTime?
  siSoToiDa           Int
  hinhThucGiangDay    HinhThucGiangDay @default(TRUC_TIEP)
  mucHocPhi           Decimal?         @db.Decimal(12, 2)
  // HP-01: chính sách miễn giảm áp dụng chung cho khóa (dạng mô tả tự do,
  // việc miễn giảm cho từng học viên cụ thể được xác nhận riêng ở HP-02).
  chinhSachMienGiam   String?
  // HP-01: "mức học phí không đổi sau khi khóa đã có học viên đăng ký, trừ
  // khi có quyết định điều chỉnh" - lưu lý do lần điều chỉnh gần nhất.
  lyDoDieuChinhHocPhi String?
  trangThai           TrangThaiKhoa    @default(CHUAN_BI)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  buoiHocs    BuoiHoc[]
  dangKys     DangKyHoc[]
  hocPhis     HocPhi[]
  chungChis   ChungChi[]
  hopDongs    HopDongLienKet[]
  giangViens  GiangVienHocPhan[]
  ketQuas     KetQuaHocTap[]
  ketQuaKhoas KetQuaKhoa[]

  @@map("khoa")
}

model GiangVien {
  id              String         @id @default(cuid())
  nguoiDungId     String?        @unique
  nguoiDung       NguoiDung?     @relation(fields: [nguoiDungId], references: [id])
  hoTen           String
  donViId         String?
  donVi           DonVi?         @relation(fields: [donViId], references: [id])
  chucDanhHocViId String?
  chucDanhHocVi   ChucDanhHocVi? @relation(fields: [chucDanhHocViId], references: [id])
  chuyenMon       String?
  // GD-03: cần kênh liên lạc để "thông báo gửi ... giảng viên" khi đổi
  // lịch/nghỉ học - giảng viên mời giảng có thể không có tài khoản đăng
  // nhập (nguoiDungId null) nên không thể chỉ dựa vào NguoiDung.email.
  email           String?
  soDienThoai     String?

  hocPhans  GiangVienHocPhan[]
  diemDanhs DiemDanh[]
  thongBaos ThongBao[]

  @@map("giang_vien")
}

// bảng nối phân công giảng viên phụ trách học phần trong 1 khóa cụ thể (KH-02)
model GiangVienHocPhan {
  id          String    @id @default(cuid())
  khoaId      String
  khoa        Khoa      @relation(fields: [khoaId], references: [id], onDelete: Cascade)
  hocPhanId   String
  hocPhan     HocPhan   @relation(fields: [hocPhanId], references: [id], onDelete: Cascade)
  giangVienId String
  giangVien   GiangVien @relation(fields: [giangVienId], references: [id])

  @@unique([khoaId, hocPhanId])
  @@map("giang_vien_hoc_phan")
}

model HocVien {
  id              String         @id @default(cuid())
  nguoiDungId     String?        @unique
  nguoiDung       NguoiDung?     @relation(fields: [nguoiDungId], references: [id])
  maHocVien       String         @unique
  hoTen           String
  ngaySinh        DateTime?
  // đơn vị công tác của học viên thường là trường/đơn vị bên ngoài, không
  // thuộc danh mục DonVi nội bộ trường (DM-01) nên giữ dạng text tự do.
  donViCongTac    String?
  chucDanhHocViId String?
  chucDanhHocVi   ChucDanhHocVi? @relation(fields: [chucDanhHocViId], references: [id])
  soCCCD          String?        @unique
  soDienThoai     String?
  email           String?

  dangKys     DangKyHoc[]
  diemDanhs   DiemDanh[]
  ketQuas     KetQuaHocTap[]
  ketQuaKhoas KetQuaKhoa[]
  hocPhis     HocPhi[]
  chungChis   ChungChi[]
  thongBaos   ThongBao[]

  @@map("hoc_vien")
}

// HV-10: nhật ký mỗi thông báo đã phát sinh cho 1 học viên - vừa là "trung
// tâm thông báo trong hệ thống" (chưa có cổng đăng nhập học viên nên trước
// mắt cán bộ xem trong hồ sơ học viên), vừa là log kết quả gửi email.
// GD-03: "thông báo gửi học viên/giảng viên" - cùng 1 bảng nhật ký, đúng 1
// trong 2 khóa ngoại hocVienId/giangVienId có giá trị (ràng buộc kiểm tra ở
// tầng ứng dụng, guiThongBao()/guiThongBaoGiangVien() không cho gọi thiếu).
model ThongBao {
  id          String             @id @default(cuid())
  hocVienId   String?
  hocVien     HocVien?           @relation(fields: [hocVienId], references: [id], onDelete: Cascade)
  giangVienId String?
  giangVien   GiangVien?         @relation(fields: [giangVienId], references: [id], onDelete: Cascade)
  loaiSuKien  LoaiSuKienThongBao
  tieuDe      String
  noiDung     String
  daGuiEmail  Boolean            @default(false)
  loiGuiEmail String?
  createdAt   DateTime           @default(now())

  @@map("thong_bao")
}

// HV-10: cấu hình SMTP để gửi email thật - chỉ 1 dòng duy nhất (singleton),
// admin nhập/sửa qua UI. Mật khẩu lưu ở dạng đã mã hóa (AES-256-GCM), không
// lưu plaintext trong DB.
model CauHinhSmtp {
  id           String   @id @default(cuid())
  host         String
  port         Int
  taiKhoan     String
  matKhauMaHoa String
  tuDiaChi     String
  capNhatLuc   DateTime @updatedAt

  @@map("cau_hinh_smtp")
}

model DangKyHoc {
  id               String          @id @default(cuid())
  hocVienId        String
  hocVien          HocVien         @relation(fields: [hocVienId], references: [id])
  khoaId           String
  khoa             Khoa            @relation(fields: [khoaId], references: [id])
  ngayDangKy       DateTime        @default(now())
  // HV-02 (Phương thức 1): hạn chót nộp bản giấy - chỉ có giá trị khi hồ sơ
  // ở CHO_NOP_GIAY; quá hạn mà chưa xác nhận thì tự động chuyển
  // HUY_QUA_HAN_NOP_GIAY.
  hanNopGiay       DateTime?
  trangThai        TrangThaiDangKy @default(CHO_DUYET)
  // HV-06: lý do đánh giá Hợp lệ/Không hợp lệ (chủ yếu ghi khi từ chối)
  ghiChuThamDinh   String?
  // HV-09: lý do của lần thêm/chuyển/ghi nhận thôi học gần nhất (lịch sử đầy
  // đủ hơn thuộc phạm vi QT-03 audit log, Đợt 2)
  lyDoThayDoi      String?
  // chỉ có giá trị khi học viên đăng ký qua đơn vị liên kết (Phương thức 4);
  // mỗi học viên qua ĐVLK gắn đúng 1 hợp đồng liên kết.
  hopDongLienKetId String?
  hopDongLienKet   HopDongLienKet? @relation(fields: [hopDongLienKetId], references: [id])

  @@unique([hocVienId, khoaId])
  @@map("dang_ky_hoc")
}

model BuoiHoc {
  id             String    @id @default(cuid())
  khoaId         String
  khoa           Khoa      @relation(fields: [khoaId], references: [id], onDelete: Cascade)
  hocPhanId      String?
  hocPhan        HocPhan?  @relation(fields: [hocPhanId], references: [id])
  ngayHoc        DateTime
  gioBatDau      String?
  gioKetThuc     String?
  phongHocId     String?
  phongHoc       PhongHoc? @relation(fields: [phongHocId], references: [id])
  linkTrucTuyen  String?
  // GD-03: "nghỉ học" - buổi bị hủy hẳn, không tổ chức (khác học bù, là 1
  // buổi mới tạo qua KH-03 thietLapBuoiHoc). lyDoThayDoi dùng chung cho cả
  // hủy lẫn đổi lịch (ghi lại lần thay đổi gần nhất).
  daHuy          Boolean   @default(false)
  lyDoThayDoi    String?
  // GD-02: nhật ký buổi học - không bắt buộc, giảng viên tự ghi sau buổi.
  noiDungDaGiang String?
  nhanXet        String?

  diemDanhs DiemDanh[]

  @@map("buoi_hoc")
}

model DiemDanh {
  id          String            @id @default(cuid())
  buoiHocId   String
  buoiHoc     BuoiHoc           @relation(fields: [buoiHocId], references: [id], onDelete: Cascade)
  hocVienId   String
  hocVien     HocVien           @relation(fields: [hocVienId], references: [id])
  giangVienId String?
  giangVien   GiangVien?        @relation(fields: [giangVienId], references: [id])
  trangThai   TrangThaiDiemDanh @default(VANG_KHONG_PHEP)

  @@unique([buoiHocId, hocVienId])
  @@map("diem_danh")
}

// KQ-01: điểm học phần gắn theo cả khóa (không chỉ học phần) vì học phần
// thuộc chương trình, 1 học viên có thể học lại cùng chương trình ở khóa khác.
model KetQuaHocTap {
  id                  String   @id @default(cuid())
  hocVienId           String
  hocVien             HocVien  @relation(fields: [hocVienId], references: [id])
  khoaId              String
  khoa                Khoa     @relation(fields: [khoaId], references: [id])
  hocPhanId           String
  hocPhan             HocPhan  @relation(fields: [hocPhanId], references: [id])
  diemThanhPhan       Decimal? @db.Decimal(4, 2)
  diemKetThuc         Decimal? @db.Decimal(4, 2)
  // điểm học phần = tổ hợp thành phần/kết thúc theo tỷ lệ QT-05, tính lại mỗi
  // lần nhập điểm (KQ-01) hoặc sửa theo phúc khảo (KQ-04).
  diemHocPhan         Decimal? @db.Decimal(4, 2)
  dat                 Boolean?
  daPheDuyet          Boolean  @default(false)
  // KQ-04: "không sửa điểm sau khi đã phê duyệt, trừ khi có quyết định phúc
  // khảo" - số quyết định của lần phúc khảo gần nhất.
  soQuyetDinhPhucKhao String?

  @@unique([hocVienId, khoaId, hocPhanId])
  @@map("ket_qua_hoc_tap")
}

// KQ-02/KQ-06: kết quả toàn khóa của 1 học viên - từ tổng hợp điểm học phần +
// chuyên cần (khóa có giảng dạy) hoặc nhập thẳng điểm thi (Phương thức 3).
// KQ-03 ghi duDieuKienHocPhi/hoanThanh; KQ-04 phê duyệt kèm số quyết định.
model KetQuaKhoa {
  id               String    @id @default(cuid())
  hocVienId        String
  hocVien          HocVien   @relation(fields: [hocVienId], references: [id])
  khoaId           String
  khoa             Khoa      @relation(fields: [khoaId], references: [id])
  diemTongKet      Decimal?  @db.Decimal(4, 2)
  // % buổi có mặt (0-100); null với khóa Phương thức 3 hoặc khóa chưa điểm
  // danh buổi nào.
  tyLeChuyenCan    Decimal?  @db.Decimal(5, 2)
  datHocTap        Boolean?
  // null = chưa xét KQ-03 (hoặc cần xét lại sau khi tổng hợp/nhập điểm lại).
  duDieuKienHocPhi Boolean?
  hoanThanh        Boolean?
  ghiChu           String?
  daPheDuyet       Boolean   @default(false)
  soQuyetDinh      String?
  ngayPheDuyet     DateTime?
  nguoiPheDuyet    String?
  capNhatLuc       DateTime  @updatedAt

  @@unique([hocVienId, khoaId])
  @@map("ket_qua_khoa")
}

model HocPhi {
  id             String          @id @default(cuid())
  hocVienId      String
  hocVien        HocVien         @relation(fields: [hocVienId], references: [id])
  khoaId         String
  khoa           Khoa            @relation(fields: [khoaId], references: [id])
  soTienPhaiNop  Decimal         @db.Decimal(12, 2)
  soTienDaNop    Decimal         @default(0) @db.Decimal(12, 2)
  ngayNop        DateTime?
  hinhThucNop    String?
  trangThai      TrangThaiHocPhi @default(CHUA_NOP)
  nguoiXacNhanId String?
  // HP-03: hạn chót nộp - dùng để tự động nhắc trước tối thiểu 7 ngày.
  hanNop         DateTime?
  lanNhacGanNhat DateTime?
  // HP-06: "có thể bỏ chặn thủ công nếu lãnh đạo phê duyệt trường hợp đặc
  // biệt" - khi true, daHoanTatNghiaVuTaiChinh() luôn trả về true bất kể
  // trangThai, bỏ qua điều kiện học phí khi xét hoàn thành khóa/cấp chứng chỉ.
  boQuaKiemTra   Boolean         @default(false)
  lyDoBoQua      String?

  phieuThus PhieuThu[]

  @@unique([hocVienId, khoaId])
  @@map("hoc_phi")
}

// HP-04: mỗi khoản nộp (có thể trả góp nhiều lần cho cùng 1 HocPhi) sinh
// đúng 1 phiếu thu, số phiếu tăng dần không trùng (retry giống mã học viên ở
// hv/dung-chung.ts).
model PhieuThu {
  id          String   @id @default(cuid())
  soPhieu     String   @unique
  hocPhiId    String
  hocPhi      HocPhi   @relation(fields: [hocPhiId], references: [id])
  soTien      Decimal  @db.Decimal(12, 2)
  hinhThucNop String?
  ngayLap     DateTime @default(now())
  nguoiLapId  String?
  nguoiLapTen String?

  @@map("phieu_thu")
}

model ChungChi {
  id        String            @id @default(cuid())
  soHieu    String?           @unique
  hocVienId String
  hocVien   HocVien           @relation(fields: [hocVienId], references: [id])
  khoaId    String
  khoa      Khoa              @relation(fields: [khoaId], references: [id])
  ngayCap   DateTime?
  nguoiKy   String?
  soVaoSo   String?
  kenhNhan  String?
  trangThai TrangThaiChungChi @default(CHO_KY_DUYET)

  @@map("chung_chi")
}

model DonViLienKet {
  id           String     @id @default(cuid())
  ma           String     @unique
  ten          String
  diaChi       String?
  nguoiDaiDien String?
  soDienThoai  String?
  // 1 tài khoản/đơn vị liên kết, chỉ thao tác trên các khóa được phân công qua hợp đồng
  taiKhoanId   String?    @unique
  taiKhoan     NguoiDung? @relation("TaiKhoanDonViLienKet", fields: [taiKhoanId], references: [id])

  hopDongs HopDongLienKet[]

  @@map("don_vi_lien_ket")
}

model HopDongLienKet {
  id              String           @id @default(cuid())
  maHopDong       String           @unique
  donViLienKetId  String
  donViLienKet    DonViLienKet     @relation(fields: [donViLienKetId], references: [id])
  khoaId          String
  khoa            Khoa             @relation(fields: [khoaId], references: [id])
  soLuongDuKien   Int?
  soLuongThucTe   Int?
  donGiaThoaThuan Decimal?         @db.Decimal(12, 2)
  trangThai       TrangThaiHopDong @default(DANG_TRIEN_KHAI)
  ngayQuyetToan   DateTime?
  soTienQuyetToan Decimal?         @db.Decimal(12, 2)

  dangKys DangKyHoc[]

  @@map("hop_dong_lien_ket")
}

// QT-04: nhật ký sao lưu - mỗi lần chạy backup (thủ công qua nút bấm admin
// hoặc tự động qua lịch bên ngoài gọi API) ghi lại đúng 1 dòng ở đây.
model SaoLuu {
  id              String             @id @default(cuid())
  thoiGianBatDau  DateTime           @default(now())
  thoiGianKetThuc DateTime?
  trangThai       TrangThaiSaoLuu    @default(DANG_CHAY)
  loaiKichHoat    LoaiKichHoatSaoLuu @default(THU_CONG)
  // tên người bấm "Sao lưu ngay"; null nếu chạy tự động theo lịch
  nguoiKichHoat   String?
  duongDanFile    String?
  kichThuocByte   Int?
  loiChiTiet      String?

  @@map("sao_luu")
}

// QT-03: "Không cho phép sửa/xóa nhật ký đã ghi" - model này chỉ có create +
// đọc (danhSachNhatKy), không có hàm update/delete nào được viết ở tầng
// service. nguoiThucHienId lưu rời (không FK) + nguoiThucHienTen snapshot lúc
// ghi, để nhật ký không vỡ/mất tên nếu tài khoản đó sau này bị xóa (QT-01).
model NhatKyThaoTac {
  id               String   @id @default(cuid())
  thoiGian         DateTime @default(now())
  nguoiThucHienId  String?
  nguoiThucHienTen String
  hanhDong         String
  doiTuong         String
  doiTuongId       String
  chiTiet          String?

  @@index([doiTuong, doiTuongId])
  @@map("nhat_ky_thao_tac")
}

// QT-05: tham số hệ thống dạng key-value chung, admin tự thêm/sửa qua UI
// (vd chính sách mật khẩu, số ngày hạn nộp giấy...). Mỗi lần sửa được ghi vào
// NhatKyThaoTac (QT-03) - đúng quy tắc nghiệp vụ của QT-05.
model ThamSoHeThong {
  id         String   @id @default(cuid())
  ma         String   @unique
  giaTri     String
  moTa       String?
  capNhatLuc DateTime @updatedAt

  @@map("tham_so_he_thong")
}
