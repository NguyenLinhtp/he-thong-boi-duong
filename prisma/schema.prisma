// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum VaiTro {
  ADMIN
  CAN_BO_QUAN_LY_DAO_TAO
  CAN_BO_TAI_CHINH
  GIANG_VIEN
  HOC_VIEN
  CAN_BO_DON_VI_LIEN_KET
}

enum TrangThaiTaiKhoan {
  HOAT_DONG
  TAM_KHOA
}

enum PhuongThucDangKy {
  TRUC_TUYEN_NOP_GIAY
  IMPORT_TU_XAC_NHAN
  CHI_DU_THI
  QUA_DON_VI_LIEN_KET
}

enum TrangThaiChuongTrinh {
  DU_THAO
  CHO_THAM_DINH
  DA_BAN_HANH
  NGUNG_HIEU_LUC
}

enum HinhThucGiangDay {
  TRUC_TIEP
  TRUC_TUYEN
}

enum TrangThaiKhoa {
  CHUAN_BI
  DANG_TUYEN_SINH
  DANG_DIEN_RA
  DA_KET_THUC
  HUY
}

enum TrangThaiDangKy {
  // HV-01 (Phương thức 1): "Đã đăng ký online - chờ nộp bản giấy"
  CHO_NOP_GIAY
  // HV-02 (Phương thức 1): "Đã nộp hồ sơ giấy - chờ duyệt"
  DA_NOP_GIAY
  // HV-02: tự động hủy khi quá hạn nộp bản giấy mà chưa được xác nhận
  HUY_QUA_HAN_NOP_GIAY
  // HV-03 (Phương thức 2): đã import, "danh sách học viên dự kiến... kèm
  // thông tin định danh để tự xác nhận" - chờ học viên tự xác nhận (HV-04)
  CHO_TU_XAC_NHAN
  // HV-04 (Phương thức 2): "Đã xác nhận tham gia"
  DA_XAC_NHAN_THAM_GIA
  CHO_DUYET
  HOP_LE
  KHONG_HOP_LE
  CHINH_THUC
  HOAN_THANH
  THOI_HOC
}

enum TrangThaiDiemDanh {
  CO_MAT
  VANG_CO_PHEP
  VANG_KHONG_PHEP
}

enum TrangThaiHocPhi {
  CHUA_NOP
  DA_NOP_DU
  CON_NO
  MIEN_GIAM
  CHO_THANH_LY_HOP_DONG
  DA_HOAN_TAT
}

enum TrangThaiHopDong {
  DANG_TRIEN_KHAI
  DA_THANH_LY
}

// CC: Đề nghị (CC-01) -> Chờ ký duyệt (CC-02, đã có số hiệu, đã in) -> Đã ký
// duyệt (CC-03) -> Đã cấp (CC-04, đã vào sổ + trao/bàn giao). Đã hủy: giữ lại
// dòng + số hiệu để "không cấp lại số đã hủy".
enum TrangThaiChungChi {
  DE_NGHI
  CHO_KY_DUYET
  DA_KY_DUYET
  DA_CAP
  DA_HUY
}

// CC-04: "trao trực tiếp cho học viên tự đăng ký, hoặc bàn giao theo lô về
// đơn vị liên kết" - kênh bắt buộc khớp nguồn đăng ký của học viên.
enum LoaiVanBang {
  CHUNG_CHI
  CHUNG_NHAN
}

enum KenhNhanChungChi {
  TRUC_TIEP
  BAN_GIAO_DVLK
}

enum TrangThaiSaoLuu {
  DANG_CHAY
  THANH_CONG
  THAT_BAI
}

enum LoaiKichHoatSaoLuu {
  THU_CONG
  TU_DONG
}

// HV-10: các loại sự kiện phát sinh thông báo theo đặc tả. NHAC_HOC_PHI/
// KET_QUA/CAP_CHUNG_CHI chưa có điểm gọi thật (module HP/KQ/CC chưa xây) -
// định nghĩa sẵn để các module đó gọi guiThongBao() ngay khi được xây, không
// cần sửa schema thêm.
enum LoaiSuKienThongBao {
  TRUNG_TUYEN
  NHAC_NOP_HO_SO_GIAY
  LICH_HOC_LICH_THI
  NHAC_HOC_PHI
  KET_QUA
  CAP_CHUNG_CHI
}

// ============================================================
// NGƯỜI DÙNG & RBAC (QT-01, QT-02)
// Ma trận phân quyền Vai trò <-> Chức năng lưu trong DB (không hard-code)
// để admin gán/thu hồi quyền qua UI mà không cần sửa code.
// ============================================================

model NguoiDung {
  id          String            @id @default(cuid())
  tenDangNhap String            @unique
  matKhauHash String
  hoTen       String
  email       String?           @unique
  // học viên có thể đăng nhập bằng CCCD hoặc mã số học viên (Phương thức 2 - HV-04)
  soCCCD      String?           @unique
  maSoHocVien String?           @unique
  trangThai   TrangThaiTaiKhoan @default(HOAT_DONG)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  vaiTros      NguoiDungVaiTro[]
  giangVien    GiangVien?
  hocVien      HocVien?
  donViLienKet DonViLienKet?     @relation("TaiKhoanDonViLienKet")

  @@map("nguoi_dung")
}

model VaiTroModel {
  id         String  @id @default(cuid())
  ma         VaiTro  @unique
  tenHienThi String
  ghiChu     String?

  nguoiDungs NguoiDungVaiTro[]
  chucNangs  VaiTroChucNang[]

  @@map("vai_tro")
}

model NguoiDungVaiTro {
  nguoiDungId String
  vaiTroId    String

  nguoiDung NguoiDung   @relation(fields: [nguoiDungId], references: [id], onDelete: Cascade)
  vaiTro    VaiTroModel @relation(fields: [vaiTroId], references: [id], onDelete: Cascade)

  @@id([nguoiDungId, vaiTroId])
  @@map("nguoi_dung_vai_tro")
}

model ChucNangHeThong {
  id           String @id @default(cuid())
  // mã chức năng theo bảng phân tích 69 chức năng, vd "DM-01"
  maCN         String @unique
  nhomChucNang String
  tenChucNang  String

  vaiTros VaiTroChucNang[]

  @@map("chuc_nang_he_thong")
}

model VaiTroChucNang {
  vaiTroId          String
  chucNangHeThongId String

  vaiTro          VaiTroModel     @relation(fields: [vaiTroId], references: [id], onDelete: Cascade)
  chucNangHeThong ChucNangHeThong @relation(fields: [chucNangHeThongId], references: [id], onDelete: Cascade)

  @@id([vaiTroId, chucNangHeThongId])
  @@map("vai_tro_chuc_nang")
}

// ============================================================
// DANH MỤC DÙNG CHUNG (DM-01..DM-05)
// ============================================================

model DonVi {
  id         String  @id @default(cuid())
  ma         String  @unique
  ten        String
  donViChaId String?
  donViCha   DonVi?  @relation("DonViCapTren", fields: [donViChaId], references: [id])
  donViCons  DonVi[] @relation("DonViCapTren")

  giangViens GiangVien[]

  @@map("don_vi")
}

model ChucDanhHocVi {
  id   String @id @default(cuid())
  ma   String @unique
  ten  String
  // phân loại: chuc_danh | hoc_ham | hoc_vi
  loai String

  giangViens GiangVien[]
  hocViens   HocVien[]

  @@map("chuc_danh_hoc_vi")
}

model LoaiHinhBoiDuong {
  id  String @id @default(cuid())
  ma  String @unique
  ten String

  chuongTrinhs ChuongTrinh[]

  @@map("loai_hinh_boi_duong")
}

model PhongHoc {
  id      String  @id @default(cuid())
  ma      String  @unique
  ten     String
  coSo    String?
  sucChua Int?

  buoiHocs BuoiHoc[]

  @@map("phong_hoc")
}

model DotTuyenSinh {
  id          String   @id @default(cuid())
  ma          String   @unique
  ten         String
  ngayBatDau  DateTime
  ngayKetThuc DateTime

  khoas Khoa[]

  @@map("dot_tuyen_sinh")
}

// ============================================================
// 13 THỰC THỂ NGHIỆP VỤ CỐT LÕI (mục 3.1 đặc tả)
// Model rỗng ở bước nền tảng này; business logic/API cho từng CN
// sẽ code ở các phiên module DM/CT/KH/HV/GD/KQ/HP/CC/DVLK sau,
// theo đúng thứ tự Đợt 1 -> 2 -> 3.
// ============================================================

model ChuongTrinh {
  id                 String               @id @default(cuid())
  maCT               String               @unique
  ten                String
  mucTieu            String?
  doiTuongApDung     String?
  tongThoiLuong      Int?
  loaiHinhBoiDuongId String
  loaiHinhBoiDuong   LoaiHinhBoiDuong     @relation(fields: [loaiHinhBoiDuongId], references: [id])
  // CT-07: mỗi chương trình gắn đúng 1 trong 4 phương thức đăng ký;
  // mọi khóa mở theo chương trình kế thừa phương thức này.
  phuongThucDangKy   PhuongThucDangKy?
  // HV-01/04/05/11/12 (bổ sung 30/09/2026): cấu hình form đăng ký của chương trình
  // (trường có sẵn bật/tắt/bắt buộc + trường tùy chỉnh) - null = form mặc định
  cauHinhFormDangKy  Json?
  // (bổ sung 07/10/2026 - HV-01/HV-05/HP-04) mẫu in: đơn đăng ký (khóa sửa riêng được) và biên lai
  // thu tiền C45-BB của chương trình - null = mẫu mặc định (src/lib/mau-in.ts)
  mauDonDangKy       Json?
  mauBienLai         Json?
  // CT-01 (bổ sung): chương trình cấp CHỨNG CHỈ hay GIẤY CHỨNG NHẬN khi học
  // viên hoàn thành - quyết định tiêu đề in, dãy số hiệu và sổ cấp (CC-02/04).
  loaiVanBang        LoaiVanBang          @default(CHUNG_CHI)
  // CT-03: quy trình Dự thảo -> Chờ thẩm định -> Đã ban hành.
  // CT-03: "Chỉ chương trình Đã ban hành mới được dùng để mở khóa" - ràng
  // buộc này áp dụng ở KH-01 (khởi tạo khóa) khi module đó được xây dựng.
  trangThai          TrangThaiChuongTrinh @default(DU_THAO)
  yKienThamDinh      String?
  soQuyetDinh        String?
  ngayBanHanh        DateTime?
  // CT-06: lý do/thời điểm chuyển sang Ngừng hiệu lực (lưu trữ) - chỉ có
  // giá trị khi trangThai = NGUNG_HIEU_LUC.
  lyDoNgungHieuLuc   String?
  ngayNgungHieuLuc   DateTime?
  // CT-04: mỗi lần sửa chương trình đã ban hành tăng số này lên 1 và lưu
  // snapshot nội dung trước khi sửa vào ChuongTrinhPhienBan.
  phienBanHienTai    Int                  @default(1)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  hocPhans  HocPhan[]
  khoas     Khoa[]
  phienBans ChuongTrinhPhienBan[]

  @@map("chuong_trinh")
}

// CT-04: snapshot nội dung chương trình TRƯỚC mỗi lần sửa khi đã ban hành -
// "lưu lại thành phiên bản mới, lưu lịch sử phiên bản cũ".
model ChuongTrinhPhienBan {
  id                 String      @id @default(cuid())
  chuongTrinhId      String
  chuongTrinh        ChuongTrinh @relation(fields: [chuongTrinhId], references: [id], onDelete: Cascade)
  phienBan           Int
  ten                String
  mucTieu            String?
  doiTuongApDung     String?
  tongThoiLuong      Int?
  loaiHinhBoiDuongId String
  lyDoSua            String?
  luuLucAt           DateTime    @default(now())

  @@unique([chuongTrinhId, phienBan])
  @@map("chuong_trinh_phien_ban")
}

model HocPhan {
  id            String      @id @default(cuid())
  chuongTrinhId String
  chuongTrinh   ChuongTrinh @relation(fields: [chuongTrinhId], references: [id], onDelete: Cascade)
  ten           String
  soTiet        Int
  thuTu         Int

  giangViens     GiangVienHocPhan[]
  buoiHocs       BuoiHoc[]
  ketQuas        KetQuaHocTap[]
  taiLieus       TaiLieuHocTap[]
  // CT-02 bổ sung 28/09/2026: học liệu khung + yêu cầu đánh giá của chuyên đề
  hocLieus       HocLieuHocPhan[]
  baiTracNghiems BaiTracNghiem[]
  yeuCauSanPhams YeuCauSanPham[]

  @@map("hoc_phan")
}

model Khoa {
  id                  String           @id @default(cuid())
  maKhoa              String           @unique
  // (bổ sung 06/10/2026) tên khóa do cán bộ đặt khi khởi tạo (vd. "Thi chuẩn đầu ra tiếng Anh đợt tháng 11 năm 2026"); null = hiển thị theo tên chương trình
  tenKhoa             String?
  chuongTrinhId       String
  chuongTrinh         ChuongTrinh      @relation(fields: [chuongTrinhId], references: [id])
  dotTuyenSinhId      String?
  dotTuyenSinh        DotTuyenSinh?    @relation(fields: [dotTuyenSinhId], references: [id])
  thoiGianKhaiGiang   DateTime?
  thoiGianBeGiang     DateTime?
  siSoToiDa           Int
  // (bổ sung 01/10/2026) hạn chót đăng ký - sau thời điểm này không nhận đăng ký mới (KH-05)
  hanDangKy           DateTime?
  hinhThucGiangDay    HinhThucGiangDay @default(TRUC_TIEP)
  // (bổ sung 30/09/2026) form đăng ký riêng của khóa - null = dùng form của chương trình
  cauHinhFormDangKy   Json?
  // (bổ sung 07/10/2026) mẫu đơn đăng ký riêng của khóa - null = dùng mẫu của chương trình
  mauDonDangKy        Json?
  mucHocPhi           Decimal?         @db.Decimal(12, 2)
  // (bổ sung 01/10/2026) khóa dự thi (PT3) định danh bằng mã sinh viên: lệ phí riêng cho thí sinh
  // tự do (không phải sinh viên ĐHSP-ĐHĐN); mucHocPhi áp cho sinh viên. null = như sinh viên
  mucHocPhiTuDo       Decimal?         @db.Decimal(12, 2)
  // HP-01: chính sách miễn giảm áp dụng chung cho khóa (dạng mô tả tự do,
  // việc miễn giảm cho từng học viên cụ thể được xác nhận riêng ở HP-02).
  chinhSachMienGiam   String?
  // HP-01: "mức học phí không đổi sau khi khóa đã có học viên đăng ký, trừ
  // khi có quyết định điều chỉnh" - lưu lý do lần điều chỉnh gần nhất.
  lyDoDieuChinhHocPhi String?
  trangThai           TrangThaiKhoa    @default(CHUAN_BI)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  buoiHocs             BuoiHoc[]
  dangKys              DangKyHoc[]
  hocPhis              HocPhi[]
  // (bổ sung 06/10/2026 - HP-01) thành phần lệ phí của khóa dự thi (vd. ôn thi, thi)
  thanhPhanLePhis      ThanhPhanLePhi[]
  chungChis            ChungChi[]
  hopDongs             HopDongLienKet[]
  giangViens           GiangVienHocPhan[]
  ketQuas              KetQuaHocTap[]
  ketQuaKhoas          KetQuaKhoa[]
  lopHocs              LopHoc[]
  quyetDinhCapVanBangs QuyetDinhCapVanBang[]
  taiLieus             TaiLieuHocTap[]
  lanLamTracNghiems    LanLamTracNghiem[]
  baiNopSanPhams       BaiNopSanPham[]

  @@map("khoa")
}

model GiangVien {
  id              String         @id @default(cuid())
  nguoiDungId     String?        @unique
  nguoiDung       NguoiDung?     @relation(fields: [nguoiDungId], references: [id])
  hoTen           String
  donViId         String?
  donVi           DonVi?         @relation(fields: [donViId], references: [id])
  chucDanhHocViId String?
  chucDanhHocVi   ChucDanhHocVi? @relation(fields: [chucDanhHocViId], references: [id])
  chuyenMon       String?
  // GD-03: cần kênh liên lạc để "thông báo gửi ... giảng viên" khi đổi
  // lịch/nghỉ học - giảng viên mời giảng có thể không có tài khoản đăng
  // nhập (nguoiDungId null) nên không thể chỉ dựa vào NguoiDung.email.
  email           String?
  soDienThoai     String?

  hocPhans  GiangVienHocPhan[]
  diemDanhs DiemDanh[]
  thongBaos ThongBao[]
  taiLieus  TaiLieuHocTap[]

  @@map("giang_vien")
}

// bảng nối phân công giảng viên phụ trách học phần trong 1 khóa cụ thể (KH-02)
// KH-07: lopId null = phân công cấp khóa, áp dụng cho buổi chung và mọi lớp
// chưa có phân công riêng cho học phần đó. Postgres coi NULL là khác nhau
// trong unique nên "1 phân công cấp khóa/học phần" được đảm bảo ở tầng
// service (phanCongGiangVien), không dựa vào ràng buộc này.
model GiangVienHocPhan {
  id          String    @id @default(cuid())
  khoaId      String
  khoa        Khoa      @relation(fields: [khoaId], references: [id], onDelete: Cascade)
  lopId       String?
  lop         LopHoc?   @relation(fields: [lopId], references: [id])
  hocPhanId   String
  hocPhan     HocPhan   @relation(fields: [hocPhanId], references: [id], onDelete: Cascade)
  giangVienId String
  giangVien   GiangVien @relation(fields: [giangVienId], references: [id])

  @@unique([khoaId, lopId, hocPhanId])
  @@map("giang_vien_hoc_phan")
}

model HocVien {
  id              String         @id @default(cuid())
  nguoiDungId     String?        @unique
  nguoiDung       NguoiDung?     @relation(fields: [nguoiDungId], references: [id])
  maHocVien       String         @unique
  hoTen           String
  ngaySinh        DateTime?
  // đơn vị công tác của học viên thường là trường/đơn vị bên ngoài, không
  // thuộc danh mục DonVi nội bộ trường (DM-01) nên giữ dạng text tự do.
  donViCongTac    String?
  chucDanhHocViId String?
  chucDanhHocVi   ChucDanhHocVi? @relation(fields: [chucDanhHocViId], references: [id])
  soCCCD          String?        @unique
  soDienThoai     String?
  email           String?
  // (bổ sung 01/10/2026) thí sinh là sinh viên của trường - đăng ký dự thi bằng mã sinh viên
  maSinhVien      String?        @unique
  lopSinhHoat     String?

  dangKys           DangKyHoc[]
  diemDanhs         DiemDanh[]
  ketQuas           KetQuaHocTap[]
  ketQuaKhoas       KetQuaKhoa[]
  hocPhis           HocPhi[]
  chungChis         ChungChi[]
  thongBaos         ThongBao[]
  lanLamTracNghiems LanLamTracNghiem[]
  baiNopSanPhams    BaiNopSanPham[]
  tienDoHocTaps     TienDoHocTap[]

  @@map("hoc_vien")
}

// HV-10: nhật ký mỗi thông báo đã phát sinh cho 1 học viên - vừa là "trung
// tâm thông báo trong hệ thống" (chưa có cổng đăng nhập học viên nên trước
// mắt cán bộ xem trong hồ sơ học viên), vừa là log kết quả gửi email.
// GD-03: "thông báo gửi học viên/giảng viên" - cùng 1 bảng nhật ký, đúng 1
// trong 2 khóa ngoại hocVienId/giangVienId có giá trị (ràng buộc kiểm tra ở
// tầng ứng dụng, guiThongBao()/guiThongBaoGiangVien() không cho gọi thiếu).
model ThongBao {
  id          String             @id @default(cuid())
  hocVienId   String?
  hocVien     HocVien?           @relation(fields: [hocVienId], references: [id], onDelete: Cascade)
  giangVienId String?
  giangVien   GiangVien?         @relation(fields: [giangVienId], references: [id], onDelete: Cascade)
  loaiSuKien  LoaiSuKienThongBao
  tieuDe      String
  noiDung     String
  daGuiEmail  Boolean            @default(false)
  loiGuiEmail String?
  createdAt   DateTime           @default(now())

  @@map("thong_bao")
}

// HV-10: cấu hình SMTP để gửi email thật - chỉ 1 dòng duy nhất (singleton),
// admin nhập/sửa qua UI. Mật khẩu lưu ở dạng đã mã hóa (AES-256-GCM), không
// lưu plaintext trong DB.
model CauHinhSmtp {
  id           String   @id @default(cuid())
  host         String
  port         Int
  taiKhoan     String
  matKhauMaHoa String
  tuDiaChi     String
  capNhatLuc   DateTime @updatedAt

  @@map("cau_hinh_smtp")
}

model DangKyHoc {
  id               String          @id @default(cuid())
  hocVienId        String
  hocVien          HocVien         @relation(fields: [hocVienId], references: [id])
  khoaId           String
  khoa             Khoa            @relation(fields: [khoaId], references: [id])
  ngayDangKy       DateTime        @default(now())
  // HV-02 (Phương thức 1): hạn chót nộp bản giấy - chỉ có giá trị khi hồ sơ
  // ở CHO_NOP_GIAY; quá hạn mà chưa xác nhận thì tự động chuyển
  // HUY_QUA_HAN_NOP_GIAY.
  hanNopGiay       DateTime?
  trangThai        TrangThaiDangKy @default(CHO_DUYET)
  // HV-06: lý do đánh giá Hợp lệ/Không hợp lệ (chủ yếu ghi khi từ chối)
  ghiChuThamDinh   String?
  // HV-09: lý do của lần thêm/chuyển/ghi nhận thôi học gần nhất (lịch sử đầy
  // đủ hơn thuộc phạm vi QT-03 audit log, Đợt 2)
  lyDoThayDoi      String?
  // chỉ có giá trị khi học viên đăng ký qua đơn vị liên kết (Phương thức 4);
  // mỗi học viên qua ĐVLK gắn đúng 1 hợp đồng liên kết.
  hopDongLienKetId String?
  hopDongLienKet   HopDongLienKet? @relation(fields: [hopDongLienKetId], references: [id])
  // KH-07: lớp hiện tại trong khóa (null = chưa xếp lớp). Kết quả học tập/học
  // phí/chứng chỉ gắn theo khóa nên đổi lớp không ảnh hưởng tới chúng.
  lopId            String?
  lop              LopHoc?         @relation(fields: [lopId], references: [id])
  // DVLK-05: lô đơn vị liên kết tổng hợp gửi về trường khi xác nhận đã thu hồ sơ giấy
  loNopHoSoId      String?
  loNopHoSo        LoNopHoSo?      @relation(fields: [loNopHoSoId], references: [id])
  // (bổ sung 30/09/2026) câu trả lời các trường tùy chỉnh của form đăng ký,
  // chụp kèm nhãn lúc đăng ký: [{ ma, nhan, kieu, giaTri }]
  thongTinBoSung   Json?
  // (sửa 05/10/2026 - HV-05) số điện thoại thí sinh dự thi khai khi đăng ký - cùng mã
  // SV/CCCD làm khóa mở lại đơn (thay 4 số cuối CCCD); lưu theo hồ sơ vì hồ sơ học
  // viên cũ không bị ghi đè số điện thoại
  soDienThoaiXacThuc String?
  // (bổ sung 07/10/2026 - HV-05) thí sinh sửa thông tin tự điền từ danh sách sinh viên (họ tên, số
  // CCCD/hộ chiếu, lớp): { truong: { cu, moi } } - để cán bộ đối chiếu khi thẩm định (HV-06)
  suaThongTinDanhSach Json?

  lichSuChuyenLops LichSuChuyenLop[]
  tepHoSos         TepHoSoDangKy[]

  @@unique([hocVienId, khoaId])
  @@map("dang_ky_hoc")
}

// (bổ sung 30/09/2026) tệp minh chứng học viên nộp kèm form đăng ký (trường kiểu Tệp)
model TepHoSoDangKy {
  id         String    @id @default(cuid())
  dangKyId   String
  dangKy     DangKyHoc @relation(fields: [dangKyId], references: [id], onDelete: Cascade)
  maTruong   String
  nhanTruong String
  tenFile    String
  loaiFile   String
  kichThuoc  Int
  khoaLuuTru String    @unique
  taiLenLuc  DateTime  @default(now())

  @@unique([dangKyId, maTruong])
  @@map("tep_ho_so_dang_ky")
}

// (bổ sung 01/10/2026) danh sách sinh viên của trường do cán bộ đào tạo import -
// nguồn tra cứu khi thí sinh đăng ký dự thi bằng mã sinh viên (HV-03/HV-05)
model SinhVien {
  id          String   @id @default(cuid())
  maSinhVien  String   @unique
  soCCCD      String   @unique
  hoTen       String
  lopSinhHoat String?
  // (bổ sung 05/10/2026 - HV-03) giá trị các cột bổ sung do cán bộ đào tạo khai báo
  // cho file mẫu (tham số SV_COT_BO_SUNG): { [mã cột]: giá trị }
  thongTinThem Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("sinh_vien")
}

// KH-07: 1 khóa chia thành nhiều lớp, mỗi lớp có thời khóa biểu/giảng viên riêng.
model LopHoc {
  id        String   @id @default(cuid())
  khoaId    String
  khoa      Khoa     @relation(fields: [khoaId], references: [id], onDelete: Cascade)
  maLop     String   @unique
  ten       String
  siSoToiDa Int?
  createdAt DateTime @default(now())

  dangKys              DangKyHoc[]
  buoiHocs             BuoiHoc[]
  phanCongs            GiangVienHocPhan[]
  lichSuDens           LichSuChuyenLop[]     @relation("LichSuDenLop")
  lichSuTus            LichSuChuyenLop[]     @relation("LichSuTuLop")
  quyetDinhCapVanBangs QuyetDinhCapVanBang[]
  taiLieus             TaiLieuHocTap[]

  @@map("lop_hoc")
}

// KH-07: mỗi lần xếp/chuyển lớp ghi 1 dòng - vừa là lịch sử, vừa là căn cứ
// xác định học viên thuộc lớp nào tại 1 ngày học (điểm danh GD-01, chuyên cần
// KQ-02): lớp tại ngày D = denLopId của dòng có ngayHieuLuc <= D gần nhất.
model LichSuChuyenLop {
  id               String    @id @default(cuid())
  dangKyId         String
  dangKy           DangKyHoc @relation(fields: [dangKyId], references: [id], onDelete: Cascade)
  tuLopId          String?
  tuLop            LopHoc?   @relation("LichSuTuLop", fields: [tuLopId], references: [id])
  denLopId         String
  denLop           LopHoc    @relation("LichSuDenLop", fields: [denLopId], references: [id])
  ngayHieuLuc      DateTime
  lyDo             String?
  nguoiThucHienTen String
  createdAt        DateTime  @default(now())

  @@index([dangKyId])
  @@map("lich_su_chuyen_lop")
}

// GD-04: học liệu số theo học phần của khóa. lopId null = cả khóa, có giá
// trị = chỉ học viên của lớp đó (KH-07). Là tệp tải lên (lưu ngoài thư mục
// public, tải qua API có kiểm tra quyền) hoặc đường link học liệu bên ngoài.
model TaiLieuHocTap {
  id          String     @id @default(cuid())
  khoaId      String
  khoa        Khoa       @relation(fields: [khoaId], references: [id])
  hocPhanId   String
  hocPhan     HocPhan    @relation(fields: [hocPhanId], references: [id])
  lopId       String?
  lop         LopHoc?    @relation(fields: [lopId], references: [id], onDelete: Restrict)
  tieuDe      String
  moTa        String?
  // tệp: tên gốc, kiểu MIME, kích thước (byte), khóa lưu trữ; link: duongLink
  tenFile     String?
  loaiFile    String?
  kichThuoc   Int?
  khoaLuuTru  String?    @unique
  duongLink   String?
  giangVienId String?
  giangVien   GiangVien? @relation(fields: [giangVienId], references: [id])
  nguoiDang   String
  createdAt   DateTime   @default(now())

  @@index([khoaId])
  @@map("tai_lieu_hoc_tap")
}

model BuoiHoc {
  id             String    @id @default(cuid())
  khoaId         String
  khoa           Khoa      @relation(fields: [khoaId], references: [id], onDelete: Cascade)
  // KH-07: buổi của 1 lớp; null = buổi chung cả khóa (khai giảng, bế giảng...).
  lopId          String?
  lop            LopHoc?   @relation(fields: [lopId], references: [id])
  hocPhanId      String?
  hocPhan        HocPhan?  @relation(fields: [hocPhanId], references: [id])
  ngayHoc        DateTime
  gioBatDau      String?
  gioKetThuc     String?
  phongHocId     String?
  phongHoc       PhongHoc? @relation(fields: [phongHocId], references: [id])
  linkTrucTuyen  String?
  // GD-03: "nghỉ học" - buổi bị hủy hẳn, không tổ chức (khác học bù, là 1
  // buổi mới tạo qua KH-03 thietLapBuoiHoc). lyDoThayDoi dùng chung cho cả
  // hủy lẫn đổi lịch (ghi lại lần thay đổi gần nhất).
  daHuy          Boolean   @default(false)
  lyDoThayDoi    String?
  // GD-02: nhật ký buổi học - không bắt buộc, giảng viên tự ghi sau buổi.
  noiDungDaGiang String?
  nhanXet        String?

  diemDanhs DiemDanh[]

  @@map("buoi_hoc")
}

model DiemDanh {
  id          String            @id @default(cuid())
  buoiHocId   String
  buoiHoc     BuoiHoc           @relation(fields: [buoiHocId], references: [id], onDelete: Cascade)
  hocVienId   String
  hocVien     HocVien           @relation(fields: [hocVienId], references: [id])
  giangVienId String?
  giangVien   GiangVien?        @relation(fields: [giangVienId], references: [id])
  trangThai   TrangThaiDiemDanh @default(VANG_KHONG_PHEP)

  @@unique([buoiHocId, hocVienId])
  @@map("diem_danh")
}

// KQ-01: điểm học phần gắn theo cả khóa (không chỉ học phần) vì học phần
// thuộc chương trình, 1 học viên có thể học lại cùng chương trình ở khóa khác.
model KetQuaHocTap {
  id                  String   @id @default(cuid())
  hocVienId           String
  hocVien             HocVien  @relation(fields: [hocVienId], references: [id])
  khoaId              String
  khoa                Khoa     @relation(fields: [khoaId], references: [id])
  hocPhanId           String
  hocPhan             HocPhan  @relation(fields: [hocPhanId], references: [id])
  diemThanhPhan       Decimal? @db.Decimal(4, 2)
  diemKetThuc         Decimal? @db.Decimal(4, 2)
  // điểm học phần = tổ hợp thành phần/kết thúc theo tỷ lệ QT-05, tính lại mỗi
  // lần nhập điểm (KQ-01) hoặc sửa theo phúc khảo (KQ-04).
  diemHocPhan         Decimal? @db.Decimal(4, 2)
  dat                 Boolean?
  daPheDuyet          Boolean  @default(false)
  // KQ-04: "không sửa điểm sau khi đã phê duyệt, trừ khi có quyết định phúc
  // khảo" - số quyết định của lần phúc khảo gần nhất.
  soQuyetDinhPhucKhao String?

  @@unique([hocVienId, khoaId, hocPhanId])
  @@map("ket_qua_hoc_tap")
}

// KQ-02/KQ-06: kết quả toàn khóa của 1 học viên - từ tổng hợp điểm học phần +
// chuyên cần (khóa có giảng dạy) hoặc nhập thẳng điểm thi (Phương thức 3).
// KQ-03 ghi duDieuKienHocPhi/hoanThanh; KQ-04 phê duyệt kèm số quyết định.
model KetQuaKhoa {
  id               String    @id @default(cuid())
  hocVienId        String
  hocVien          HocVien   @relation(fields: [hocVienId], references: [id])
  khoaId           String
  khoa             Khoa      @relation(fields: [khoaId], references: [id])
  diemTongKet      Decimal?  @db.Decimal(4, 2)
  // % buổi có mặt (0-100); null với khóa Phương thức 3 hoặc khóa chưa điểm
  // danh buổi nào.
  tyLeChuyenCan    Decimal?  @db.Decimal(5, 2)
  datHocTap        Boolean?
  // null = chưa xét KQ-03 (hoặc cần xét lại sau khi tổng hợp/nhập điểm lại).
  duDieuKienHocPhi Boolean?
  hoanThanh        Boolean?
  ghiChu           String?
  daPheDuyet       Boolean   @default(false)
  soQuyetDinh      String?
  ngayPheDuyet     DateTime?
  nguoiPheDuyet    String?
  capNhatLuc       DateTime  @updatedAt

  @@unique([hocVienId, khoaId])
  @@map("ket_qua_khoa")
}

model HocPhi {
  id             String          @id @default(cuid())
  hocVienId      String
  hocVien        HocVien         @relation(fields: [hocVienId], references: [id])
  khoaId         String
  khoa           Khoa            @relation(fields: [khoaId], references: [id])
  soTienPhaiNop  Decimal         @db.Decimal(12, 2)
  soTienDaNop    Decimal         @default(0) @db.Decimal(12, 2)
  ngayNop        DateTime?
  hinhThucNop    String?
  trangThai      TrangThaiHocPhi @default(CHUA_NOP)
  nguoiXacNhanId String?
  // HP-03: hạn chót nộp - dùng để tự động nhắc trước tối thiểu 7 ngày.
  hanNop         DateTime?
  lanNhacGanNhat DateTime?
  // HP-06: "có thể bỏ chặn thủ công nếu lãnh đạo phê duyệt trường hợp đặc
  // biệt" - khi true, daHoanTatNghiaVuTaiChinh() luôn trả về true bất kể
  // trangThai, bỏ qua điều kiện học phí khi xét hoàn thành khóa/cấp chứng chỉ.
  boQuaKiemTra   Boolean         @default(false)
  lyDoBoQua      String?

  phieuThus PhieuThu[]
  // (bổ sung 08/10/2026 - HP-02) giao dịch chuyển khoản ngân hàng đã khớp vào khoản này
  giaoDichNganHangs GiaoDichNganHang[]
  // (bổ sung 06/10/2026) khóa có thành phần lệ phí: các thành phần thí sinh đã chọn;
  // soTienPhaiNop/soTienDaNop/trangThai của HocPhi = tổng hợp các thành phần
  thanhPhans HocPhiThanhPhan[]

  @@unique([hocVienId, khoaId])
  @@map("hoc_phi")
}

// HP-04: mỗi khoản nộp (có thể trả góp nhiều lần cho cùng 1 HocPhi) sinh
// đúng 1 phiếu thu, số phiếu tăng dần không trùng (retry giống mã học viên ở
// hv/dung-chung.ts).
model PhieuThu {
  id          String   @id @default(cuid())
  soPhieu     String   @unique
  hocPhiId    String
  hocPhi      HocPhi   @relation(fields: [hocPhiId], references: [id])
  soTien      Decimal  @db.Decimal(12, 2)
  hinhThucNop String?
  ngayLap     DateTime @default(now())
  nguoiLapId  String?
  nguoiLapTen String?
  // (sửa 07/10/2026 - HP-02/HP-04) 1 lần thu = 1 biên lai; khóa có thành phần lệ phí: mỗi thành
  // phần thu trong lần đó là 1 dòng chi tiết (thay cho liên kết 1 phiếu - 1 thành phần trước đây)
  chiTiets    PhieuThuChiTiet[]
  // (bổ sung 07/10/2026 - HP-04) nội dung in đã chốt khi lập (đơn vị, quyển số, nội dung thu...) -
  // in lại luôn đúng như lúc phát hành dù mẫu biên lai đổi sau đó; null = phiếu cũ, in theo mẫu hiện hành
  noiDungIn   Json?
  // biên lai lập thay cho biên lai đã hủy (hủy 1 phần của biên lai nhiều phần)
  thayChoSoPhieu String?
  // (bổ sung 06/10/2026 - HP-02/HP-04) hủy ghi nhận thanh toán: phiếu giữ số,
  // không xóa, không cấp lại số; không tính vào doanh thu/đối soát
  daHuy       Boolean   @default(false)
  lyDoHuy     String?
  huyLuc      DateTime?
  nguoiHuyTen String?

  @@map("phieu_thu")
}

// (bổ sung 08/10/2026 - HP-02) kết quả xử lý 1 giao dịch chuyển khoản đến tài khoản nhận lệ phí
enum TrangThaiGiaoDichNganHang {
  // khớp đúng 1 khoản, đã ghi nhận toàn bộ số tiền + lập biên lai tự động
  DA_GHI_NHAN
  // khớp được khoản nhưng chuyển thừa: đã ghi nhận phần còn phải nộp, phần thừa chờ cán bộ tài chính xử lý
  THUA_TIEN
  // không ghi nhận tự động (không khớp/khớp nhiều hồ sơ/khoản đã xong/hồ sơ đã hủy...) - chờ xử lý thủ công
  CAN_XU_LY
  // cán bộ tài chính đã xử lý thủ công (gán vào hồ sơ hoặc ghi chú hoàn tiền/bỏ qua)
  DA_XU_LY
}

// (bổ sung 08/10/2026 - HP-02) giao dịch ngân hàng nhận qua webhook dịch vụ theo dõi tài khoản
// (SePay/Casso) hoặc giao dịch thử nghiệm; mỗi giao dịch của 1 nguồn chỉ xử lý 1 lần
model GiaoDichNganHang {
  id               String                    @id @default(cuid())
  nguon            String
  maGiaoDichNguon  String
  soTaiKhoan       String?
  soTien           Decimal                   @db.Decimal(12, 2)
  noiDung          String
  maThamChieu      String?
  thoiGianGiaoDich DateTime
  nhanLuc          DateTime                  @default(now())
  trangThai        TrangThaiGiaoDichNganHang
  // lý do không ghi nhận tự động / ghi chú khi xử lý
  ghiChu           String?
  hocPhiId         String?
  hocPhi           HocPhi?                   @relation(fields: [hocPhiId], references: [id])
  soTienGhiNhan    Decimal                   @default(0) @db.Decimal(12, 2)
  soPhieuThu       String?
  duLieuGoc        Json?
  xuLyBoiTen       String?
  xuLyLuc          DateTime?

  @@unique([nguon, maGiaoDichNguon])
  @@index([trangThai])
  @@index([hocPhiId])
  @@map("giao_dich_ngan_hang")
}

// (bổ sung 07/10/2026 - HP-02/HP-04) dòng chi tiết của biên lai: 1 thành phần lệ phí thu trong lần đó
model PhieuThuChiTiet {
  id                String          @id @default(cuid())
  phieuThuId        String
  phieuThu          PhieuThu        @relation(fields: [phieuThuId], references: [id], onDelete: Cascade)
  hocPhiThanhPhanId String
  hocPhiThanhPhan   HocPhiThanhPhan @relation(fields: [hocPhiThanhPhanId], references: [id])
  noiDung           String
  soTien            Decimal         @db.Decimal(12, 2)

  @@index([hocPhiThanhPhanId])
  @@map("phieu_thu_chi_tiet")
}

// (bổ sung 06/10/2026 - HP-01) thành phần lệ phí cấu hình động của khóa dự thi (PT3):
// thí sinh luôn có thành phần bắt buộc, chọn thêm thành phần tùy chọn khi đăng ký
model ThanhPhanLePhi {
  id          String   @id @default(cuid())
  khoaId      String
  khoa        Khoa     @relation(fields: [khoaId], references: [id], onDelete: Cascade)
  ten         String
  batBuoc     Boolean  @default(false)
  // mức sinh viên ĐHSP-ĐHĐN; thí sinh tự do theo mucTuDo (null = như sinh viên)
  mucSinhVien Decimal  @db.Decimal(12, 2)
  mucTuDo     Decimal? @db.Decimal(12, 2)
  thuTu       Int      @default(0)

  hocPhiThanhPhans HocPhiThanhPhan[]

  @@map("thanh_phan_le_phi")
}

// (bổ sung 06/10/2026 - HP-02) 1 thành phần lệ phí thí sinh đã chọn - xác nhận/hủy theo từng phần
model HocPhiThanhPhan {
  id            String          @id @default(cuid())
  hocPhiId      String
  hocPhi        HocPhi          @relation(fields: [hocPhiId], references: [id], onDelete: Cascade)
  thanhPhanId   String
  thanhPhan     ThanhPhanLePhi  @relation(fields: [thanhPhanId], references: [id])
  soTienPhaiNop Decimal         @db.Decimal(12, 2)
  soTienDaNop   Decimal         @default(0) @db.Decimal(12, 2)
  trangThai     TrangThaiHocPhi @default(CHUA_NOP)

  phieuThuChiTiets PhieuThuChiTiet[]

  @@unique([hocPhiId, thanhPhanId])
  @@map("hoc_phi_thanh_phan")
}

// CC-01..04. Không có thao tác xóa ở tầng service: hồ sơ lưu vĩnh viễn (CC-04),
// chứng chỉ hủy vẫn giữ dòng + số hiệu (CC-02 "không cấp lại số đã hủy").
// Mỗi (học viên, khóa) chỉ có tối đa 1 chứng chỉ chưa hủy - kiểm tra ở service.
model ChungChi {
  id           String               @id @default(cuid())
  hocVienId    String
  hocVien      HocVien              @relation(fields: [hocVienId], references: [id])
  khoaId       String
  khoa         Khoa                 @relation(fields: [khoaId], references: [id])
  trangThai    TrangThaiChungChi    @default(DE_NGHI)
  // chụp lại loại văn bằng của chương trình lúc đề nghị (CC-01) - văn bằng đã
  // lập không đổi loại theo chương trình
  loaiVanBang  LoaiVanBang          @default(CHUNG_CHI)
  // CC-01
  nguoiDeNghi  String?
  createdAt    DateTime             @default(now())
  // CC-02: số hiệu theo sổ cấp, tăng dần, không trùng
  soHieu       String?              @unique
  ngayInSoHieu DateTime?
  // CC-05: mã xác thực ngẫu nhiên (không đoán được) in trong mã QR trên văn bằng
  maXacThuc    String?              @unique
  // CC-03: ký duyệt theo quyết định (nhập theo khóa hoặc theo lớp)
  quyetDinhId  String?
  quyetDinh    QuyetDinhCapVanBang? @relation(fields: [quyetDinhId], references: [id])
  soQuyetDinh  String?
  ngayCap      DateTime?
  nguoiKy      String?
  // CC-04: vào sổ cấp + trả chứng chỉ
  soVaoSo      String?              @unique
  kenhNhan     KenhNhanChungChi?
  nguoiNhan    String?
  ngayNhan     DateTime?
  banGiaoId    String?
  banGiao      BanGiaoChungChi?     @relation(fields: [banGiaoId], references: [id])
  // hủy (trước khi cấp)
  lyDoHuy      String?
  ngayHuy      DateTime?

  @@index([khoaId])
  @@map("chung_chi")
}

// CC-03 (bổ sung): quyết định cấp văn bằng đã ban hành, nhập theo khóa (lopId
// null) hoặc theo 1 lớp (KH-07) - lưu làm dữ liệu, mỗi văn bằng trỏ về quyết
// định của nó. Không có thao tác xóa (hồ sơ lưu trữ).
model QuyetDinhCapVanBang {
  id          String      @id @default(cuid())
  soQuyetDinh String
  ngayKy      DateTime
  nguoiKy     String
  loaiVanBang LoaiVanBang
  khoaId      String
  khoa        Khoa        @relation(fields: [khoaId], references: [id])
  lopId       String?
  lop         LopHoc?     @relation(fields: [lopId], references: [id])
  nguoiNhap   String
  createdAt   DateTime    @default(now())

  chungChis ChungChi[]

  @@index([khoaId])
  @@map("quyet_dinh_cap_van_bang")
}

// CC-04: 1 lô bàn giao chứng chỉ về đơn vị liên kết theo hợp đồng - chỉ lập
// được sau khi hợp đồng đã thanh lý (DVLK-06).
model BanGiaoChungChi {
  id               String         @id @default(cuid())
  maLo             String         @unique
  hopDongLienKetId String
  hopDongLienKet   HopDongLienKet @relation(fields: [hopDongLienKetId], references: [id])
  ngayBanGiao      DateTime
  // thông tin để quản lý, không bắt buộc (bổ sung 26/09/2026)
  nguoiDaiDienNhan String?
  nguoiBanGiao     String
  ghiChu           String?
  createdAt        DateTime       @default(now())

  chungChis ChungChi[]

  @@map("ban_giao_chung_chi")
}

// DVLK-01: trạng thái hợp tác - Tạm ngừng thì không lập hợp đồng liên kết mới
// (DVLK-03), hợp đồng đang có vẫn được theo dõi/thanh lý bình thường.
enum TrangThaiHopTac {
  DANG_HOP_TAC
  TAM_NGUNG
}

model DonViLienKet {
  id              String          @id @default(cuid())
  ma              String          @unique
  ten             String
  diaChi          String?
  nguoiDaiDien    String?
  soDienThoai     String?
  email           String?
  trangThaiHopTac TrangThaiHopTac @default(DANG_HOP_TAC)
  createdAt       DateTime        @default(now())
  // 1 tài khoản/đơn vị liên kết, chỉ thao tác trên các khóa được phân công qua hợp đồng
  taiKhoanId      String?         @unique
  taiKhoan        NguoiDung?      @relation("TaiKhoanDonViLienKet", fields: [taiKhoanId], references: [id])

  hopDongs HopDongLienKet[]

  @@map("don_vi_lien_ket")
}

model HopDongLienKet {
  id                 String           @id @default(cuid())
  maHopDong          String           @unique
  donViLienKetId     String
  donViLienKet       DonViLienKet     @relation(fields: [donViLienKetId], references: [id])
  khoaId             String
  khoa               Khoa             @relation(fields: [khoaId], references: [id])
  soLuongDuKien      Int?
  soLuongThucTe      Int?
  donGiaThoaThuan    Decimal?         @db.Decimal(12, 2)
  trangThai          TrangThaiHopDong @default(DANG_TRIEN_KHAI)
  ngayQuyetToan      DateTime?
  soTienQuyetToan    Decimal?         @db.Decimal(12, 2)
  // DVLK-06: biên bản thanh lý - số liệu đối chiếu chốt tại thời điểm thanh lý
  soBienBanThanhLy   String?          @unique
  nguoiThanhLy       String?
  ghiChuThanhLy      String?
  soHocVienHoanThanh Int?
  soHocVienThoiHoc   Int?
  ghiChu             String?
  createdAt          DateTime         @default(now())

  dangKys    DangKyHoc[]
  banGiaos   BanGiaoChungChi[]
  loNopHoSos LoNopHoSo[]

  @@map("hop_dong_lien_ket")
}

// DVLK-05: 1 lần đơn vị liên kết xác nhận đã thu đủ đơn giấy và tổng hợp
// gửi về trường (bản giấy/scan). Ngày gửi, hình thức, ghi chú chỉ để quản lý,
// không bắt buộc.
model LoNopHoSo {
  id               String         @id @default(cuid())
  maLo             String         @unique
  hopDongLienKetId String
  hopDongLienKet   HopDongLienKet @relation(fields: [hopDongLienKetId], references: [id])
  ngayGui          DateTime       @default(now())
  hinhThuc         String?
  ghiChu           String?
  nguoiXacNhan     String
  createdAt        DateTime       @default(now())

  dangKys DangKyHoc[]

  @@map("lo_nop_ho_so")
}

// QT-04: nhật ký sao lưu - mỗi lần chạy backup (thủ công qua nút bấm admin
// hoặc tự động qua lịch bên ngoài gọi API) ghi lại đúng 1 dòng ở đây.
model SaoLuu {
  id              String             @id @default(cuid())
  thoiGianBatDau  DateTime           @default(now())
  thoiGianKetThuc DateTime?
  trangThai       TrangThaiSaoLuu    @default(DANG_CHAY)
  loaiKichHoat    LoaiKichHoatSaoLuu @default(THU_CONG)
  // tên người bấm "Sao lưu ngay"; null nếu chạy tự động theo lịch
  nguoiKichHoat   String?
  duongDanFile    String?
  kichThuocByte   Int?
  loiChiTiet      String?

  @@map("sao_luu")
}

// QT-03: "Không cho phép sửa/xóa nhật ký đã ghi" - model này chỉ có create +
// đọc (danhSachNhatKy), không có hàm update/delete nào được viết ở tầng
// service. nguoiThucHienId lưu rời (không FK) + nguoiThucHienTen snapshot lúc
// ghi, để nhật ký không vỡ/mất tên nếu tài khoản đó sau này bị xóa (QT-01).
model NhatKyThaoTac {
  id               String   @id @default(cuid())
  thoiGian         DateTime @default(now())
  nguoiThucHienId  String?
  nguoiThucHienTen String
  hanhDong         String
  doiTuong         String
  doiTuongId       String
  chiTiet          String?

  @@index([doiTuong, doiTuongId])
  @@map("nhat_ky_thao_tac")
}

// QT-05: tham số hệ thống dạng key-value chung, admin tự thêm/sửa qua UI
// (vd chính sách mật khẩu, số ngày hạn nộp giấy...). Mỗi lần sửa được ghi vào
// NhatKyThaoTac (QT-03) - đúng quy tắc nghiệp vụ của QT-05.
model ThamSoHeThong {
  id         String   @id @default(cuid())
  ma         String   @unique
  giaTri     String
  moTa       String?
  capNhatLuc DateTime @updatedAt

  @@map("tham_so_he_thong")
}

// BC-04: cách nhóm dòng của biểu báo cáo gửi cấp trên
enum NhomBaoCao {
  TONG
  LOAI_HINH
  CHUONG_TRINH
  KHOA
}

// BC-04: mẫu biểu báo cáo gửi cấp trên (Bộ/Sở GD&ĐT). "Cập nhật mẫu biểu khi
// có thay đổi quy định": sửa = tạo phiên bản mới (ma, phienBan), phiên bản cũ
// giữ lại (dangApDung = false) để xuất lại đúng mẫu của kỳ trước.
// cot = [{ chiTieu, tieuDe }] theo thứ tự cột, chiTieu thuộc danh mục chỉ tiêu
// trong services/bc/bc-04-mau-bieu.ts.
model MauBieuBaoCao {
  id           String     @id @default(cuid())
  ma           String
  phienBan     Int
  ten          String
  coQuanNhan   String?
  canCu        String?
  nhomTheo     NhomBaoCao
  cot          Json
  dangApDung   Boolean    @default(true)
  nguoiCapNhat String
  createdAt    DateTime   @default(now())

  @@unique([ma, phienBan])
  @@map("mau_bieu_bao_cao")
}

// ---- CT-02 / GD-04 / KQ-01 bổ sung 28/09/2026: học liệu khung theo chương trình ----

enum LoaiHocLieu {
  TAI_LIEU
  SLIDE
  THONG_TIN
  VIDEO
}

/// Học liệu khung của 1 học phần/chuyên đề - mọi khóa mở từ chương trình dùng chung.
/// Mỗi mục là 1 tệp, 1 đường link hoặc (với THONG_TIN) nội dung văn bản.
model HocLieuHocPhan {
  id         String      @id @default(cuid())
  hocPhanId  String
  hocPhan    HocPhan     @relation(fields: [hocPhanId], references: [id], onDelete: Cascade)
  loai       LoaiHocLieu
  tieuDe     String
  moTa       String?
  noiDung    String?
  tenFile    String?
  loaiFile   String?
  kichThuoc  Int?
  khoaLuuTru String?     @unique
  duongLink  String?
  thuTu      Int         @default(0)
  nguoiDang  String
  createdAt  DateTime    @default(now())

  @@index([hocPhanId])
  @@map("hoc_lieu_hoc_phan")
}

/// Bài trắc nghiệm của chuyên đề: chỉ để tự kiểm tra (tinhDiem = false) hoặc
/// tính vào điểm đánh giá trực tuyến của học phần theo hệ số.
model BaiTracNghiem {
  id           String             @id @default(cuid())
  hocPhanId    String
  hocPhan      HocPhan            @relation(fields: [hocPhanId], references: [id], onDelete: Cascade)
  tieuDe       String
  moTa         String?
  thoiGianPhut Int?
  soLanToiDa   Int?
  tinhDiem     Boolean            @default(false)
  heSo         Decimal            @default(1) @db.Decimal(4, 2)
  thuTu        Int                @default(0)
  createdAt    DateTime           @default(now())
  cauHois      CauHoiTracNghiem[]
  lanLams      LanLamTracNghiem[]

  @@index([hocPhanId])
  @@map("bai_trac_nghiem")
}

model CauHoiTracNghiem {
  id        String        @id @default(cuid())
  baiId     String
  bai       BaiTracNghiem @relation(fields: [baiId], references: [id], onDelete: Cascade)
  noiDung   String
  phuongAn  String[]
  // chỉ số (0-based) các phương án đúng; nhiều phần tử = câu nhiều đáp án
  dapAnDung Int[]
  thuTu     Int           @default(0)

  @@index([baiId])
  @@map("cau_hoi_trac_nghiem")
}

/// 1 lần học viên làm bài (theo khóa). Bắt đầu tạo bản ghi, nộp mới có điểm.
model LanLamTracNghiem {
  id        String        @id @default(cuid())
  baiId     String
  bai       BaiTracNghiem @relation(fields: [baiId], references: [id], onDelete: Restrict)
  khoaId    String
  khoa      Khoa          @relation(fields: [khoaId], references: [id])
  hocVienId String
  hocVien   HocVien       @relation(fields: [hocVienId], references: [id])
  batDauLuc DateTime      @default(now())
  nopLuc    DateTime?
  traLoi    Json?
  soCauDung Int?
  tongSoCau Int?
  diem      Decimal?      @db.Decimal(4, 2)

  @@index([baiId, khoaId, hocVienId])
  @@map("lan_lam_trac_nghiem")
}

/// Yêu cầu sản phẩm cuối khóa của chuyên đề (học viên nộp tệp, giảng viên chấm).
model YeuCauSanPham {
  id        String          @id @default(cuid())
  hocPhanId String
  hocPhan   HocPhan         @relation(fields: [hocPhanId], references: [id], onDelete: Cascade)
  tieuDe    String
  moTa      String?
  tinhDiem  Boolean         @default(false)
  heSo      Decimal         @default(1) @db.Decimal(4, 2)
  thuTu     Int             @default(0)
  createdAt DateTime        @default(now())
  baiNops   BaiNopSanPham[]

  @@index([hocPhanId])
  @@map("yeu_cau_san_pham")
}

model BaiNopSanPham {
  id         String        @id @default(cuid())
  yeuCauId   String
  yeuCau     YeuCauSanPham @relation(fields: [yeuCauId], references: [id], onDelete: Restrict)
  khoaId     String
  khoa       Khoa          @relation(fields: [khoaId], references: [id])
  hocVienId  String
  hocVien    HocVien       @relation(fields: [hocVienId], references: [id])
  tenFile    String
  loaiFile   String
  kichThuoc  Int
  khoaLuuTru String        @unique
  ghiChu     String?
  nopLuc     DateTime      @default(now())
  diem       Decimal?      @db.Decimal(4, 2)
  nhanXet    String?
  nguoiCham  String?
  chamLuc    DateTime?

  @@unique([yeuCauId, khoaId, hocVienId])
  @@map("bai_nop_san_pham")
}

// ---- GD-04 bổ sung 29/09/2026: tiến độ, thảo luận, ghi chép trên màn hình học ----
// mucKey: "HL-<id>" học liệu khung, "GV-<id>" tài liệu giảng viên bổ sung,
// "TN-<id>" bài trắc nghiệm, "SP-<id>" yêu cầu sản phẩm.

/// Mục học liệu học viên đã hoàn thành (trắc nghiệm/sản phẩm suy ra từ bài làm, không lưu ở đây).
model TienDoHocTap {
  id           String   @id @default(cuid())
  khoaId       String
  hocVienId    String
  hocVien      HocVien  @relation(fields: [hocVienId], references: [id])
  mucKey       String
  hoanThanhLuc DateTime @default(now())

  @@unique([khoaId, hocVienId, mucKey])
  @@map("tien_do_hoc_tap")
}

model ThaoLuanHocTap {
  id          String   @id @default(cuid())
  khoaId      String
  mucKey      String
  nguoiDungId String
  hoTen       String
  vaiTro      String
  noiDung     String
  createdAt   DateTime @default(now())

  @@index([mucKey, khoaId])
  @@map("thao_luan_hoc_tap")
}

model GhiChepHocTap {
  id          String   @id @default(cuid())
  nguoiDungId String
  khoaId      String
  mucKey      String
  noiDung     String
  updatedAt   DateTime @updatedAt

  @@unique([nguoiDungId, khoaId, mucKey])
  @@map("ghi_chep_hoc_tap")
}
